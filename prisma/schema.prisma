datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  OWNER
  OPERATOR
}

enum DeliverySource {
  MANUAL
  IFOOD
  NINETY_NINE_FOOD
  KEETA
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum CancellationType {
  BEFORE_DEPARTURE
  ON_SITE
}

enum SettlementStatus {
  OPEN
  PAID
}

enum ActorType {
  USER
  COURIER
  SYSTEM
}

model Store {
  id             String          @id @default(uuid())
  slug           String          @unique
  name           String
  cnpj           String?
  phone          String
  originAddress  String
  originLat      Float?
  originLng      Float?

  users          User[]
  couriers       Courier[]
  deliveries     Delivery[]
  rateRules      RateRule[]
  settlements    Settlement[]
  webhookConfigs WebhookConfig[]
  auditEvents    AuditEvent[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([slug])
}

model User {
  id                  String    @id @default(uuid())
  storeId             String
  store               Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email               String    @unique
  passwordHash        String
  role                UserRole  @default(OPERATOR)
  active              Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([storeId])
}

model Courier {
  id                String       @id @default(uuid())
  storeId           String
  store             Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name              String
  phone             String
  vehiclePlate      String?
  vehicleModel      String?
  pixKeyType        String       @default("PHONE")
  pixKey            String
  active            Boolean      @default(true)
  tokenHash         String       @unique
  pinHash           String
  pinFailedAttempts Int          @default(0)
  pinLockedUntil    DateTime?
  sessionVersion    Int          @default(1)

  deliveries        Delivery[]
  settlements       Settlement[]

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([storeId])
  @@index([tokenHash])
}

model Delivery {
  id               String            @id @default(uuid())
  storeId          String
  store            Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  courierId        String?
  courier          Courier?          @relation(fields: [courierId], references: [id], onDelete: SetNull)
  source           DeliverySource    @default(MANUAL)
  externalId       String?
  orderNumber      String
  customerName     String
  customerPhone    String?
  street           String
  number           String
  neighborhood     String
  city             String
  state            String
  distanceKm       Decimal           @db.Decimal(6, 2)
  feeAmountCents   Int               @default(0)
  status           DeliveryStatus    @default(PENDING)
  isFeePayable     Boolean           @default(false)
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  cancellationType CancellationType?

  settlementId     String?
  settlement       Settlement?       @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([storeId, source, externalId])
  @@index([storeId])
  @@index([courierId])
  @@index([createdAt])
  @@index([status])
}

model RateRule {
  id         String   @id @default(uuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  minKm      Decimal  @db.Decimal(6, 2)
  maxKm      Decimal  @db.Decimal(6, 2)
  feeCents   Int
  orderIndex Int      @default(1)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([storeId])
}

model Settlement {
  id         String           @id @default(uuid())
  storeId    String
  store      Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  courierId  String
  courier    Courier          @relation(fields: [courierId], references: [id], onDelete: Cascade)
  weekStart  DateTime
  weekEnd    DateTime
  totalCents Int              @default(0)
  status     SettlementStatus @default(OPEN)
  paidAt     DateTime?

  deliveries Delivery[]

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([courierId, weekStart])
  @@index([storeId])
}

model WebhookConfig {
  id               String   @id @default(uuid())
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  provider         String
  secretCiphertext String
  active           Boolean  @default(true)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([storeId])
}

model AuditEvent {
  id         String    @id @default(uuid())
  storeId    String
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  actorType  ActorType
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?

  createdAt  DateTime  @default(now())

  @@index([storeId])
  @@index([createdAt])
}
