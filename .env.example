# Configurações do Banco de Dados PostgreSQL (Prisma ORM)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/entregueja_db?schema=public"

# Segredos de Autenticação e Sessão
AUTH_SECRET="gerar_chave_aleatoria_32_bytes_para_authjs"
SESSION_SECRET="gerar_chave_aleatoria_para_assinatura_de_sessoes_jose"
WEBHOOK_ENCRYPTION_KEY="gerar_chave_de_criptografia_para_payloads_de_webhooks"

# Motor de Roteamento Viário (OSRM)
# Em produção, aponte para um container dedicado do OSRM.
# router.project-osrm.org é apenas para demonstração/testes e não deve ser usado em alta escala.
OSRM_BASE_URL="https://router.project-osrm.org"

# Geocodificação OpenStreetMap (Nominatim)
# Obrigatório: Identificador único da sua aplicação no cabeçalho User-Agent (limite de 1 req/s)
NOMINATIM_USER_AGENT="EntregueJa-DeliverySaaS/1.0 (contato@entregueja.com.br)"
